{
  "name": "slack-await-claude-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin: wake a waiting session when a colleague replies in Slack",
  "license": "MIT",
  "author": "nx-solutions-ug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/slack-await-claude-plugin.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "lint": "oxlint --import-plugin",
    "lint:fix": "oxlint --import-plugin --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "check:dist": "bun run build && git diff --exit-code -- plugins/slack-await/dist"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.82.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.4"
}
